<?xml version="1.0" ?>
<!--
  shelfbot_store_aisle.sdf — Gazebo Harmonic world (v2)

  Key fixes vs v1:
  1. shelf_unit rebuilt as a SINGLE LINK with all structural boxes merged.
     This eliminates:
       - Ogre2 duplicate-material-hash crash (too many visuals with same colour)
       - DART "link not in entity map" from too many static sub-links
  2. Each <visual> has a unique <material><script><name> so Ogre2 can distinguish them.
  3. ground_plane uses Gazebo's built-in URI so it doesn't need resource-path resolution.
  4. Physics uses "dart" (most stable for rigid bodies with prismatic joints).

  Scene layout:
    Shelf face at y = 0.  Robot spawns at y = −0.80, facing +Y (yaw = π/2).
    4 levels: beams at z = 0.25 / 0.55 / 0.85 / 1.15 m
    Bottles on levels 1 and 2.  Level 1 Bay 2 is empty (OOS slot).
-->
<sdf version="1.9">
  <world name="shelfbot_store_aisle">

    <!-- ── Physics ─────────────────────────────────────────────────────────── -->
    <physics name="dart_1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ── Required Gazebo systems ──────────────────────────────────────────── -->
    <plugin filename="gz-sim8-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim8-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim8-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim8-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim8-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim8-contact-system"
            name="gz::sim::systems::Contact"/>

    <!-- ── Sun ──────────────────────────────────────────────────────────────── -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ── Ground plane ─────────────────────────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════════════════════
         S H E L F   U N I T  — SINGLE LINK (avoids Ogre2 hash collision)
         All structural geometry merged into one link.
         Pose: centred at x=0.60, y=0.20  (face at y=0)
    ══════════════════════════════════════════════════════════════════════════ -->
    <model name="shelf_unit">
      <static>true</static>
      <pose>0.60 0.20 0 0 0 0</pose>

      <link name="structure">
        <!-- ── Collisions (merged — one compound body) ── -->

        <!-- Back panel -->
        <collision name="back_panel">
          <pose>0 0.185 0.90 0 0 0</pose>
          <geometry><box><size>1.20 0.03 1.80</size></box></geometry>
        </collision>
        <!-- Left upright -->
        <collision name="upright_left">
          <pose>-0.585 0.10 0.90 0 0 0</pose>
          <geometry><box><size>0.03 0.40 1.80</size></box></geometry>
        </collision>
        <!-- Right upright -->
        <collision name="upright_right">
          <pose>0.585 0.10 0.90 0 0 0</pose>
          <geometry><box><size>0.03 0.40 1.80</size></box></geometry>
        </collision>
        <!-- Beams (4 levels) -->
        <collision name="beam_l0"><pose>0 0.00 0.25 0 0 0</pose>
          <geometry><box><size>1.20 0.04 0.04</size></box></geometry></collision>
        <collision name="beam_l1"><pose>0 0.00 0.55 0 0 0</pose>
          <geometry><box><size>1.20 0.04 0.04</size></box></geometry></collision>
        <collision name="beam_l2"><pose>0 0.00 0.85 0 0 0</pose>
          <geometry><box><size>1.20 0.04 0.04</size></box></geometry></collision>
        <collision name="beam_l3"><pose>0 0.00 1.15 0 0 0</pose>
          <geometry><box><size>1.20 0.04 0.04</size></box></geometry></collision>
        <!-- Deck surfaces -->
        <collision name="deck_l0"><pose>0 0.10 0.275 0 0 0</pose>
          <geometry><box><size>1.20 0.35 0.01</size></box></geometry></collision>
        <collision name="deck_l1"><pose>0 0.10 0.575 0 0 0</pose>
          <geometry><box><size>1.20 0.35 0.01</size></box></geometry></collision>
        <collision name="deck_l2"><pose>0 0.10 0.875 0 0 0</pose>
          <geometry><box><size>1.20 0.35 0.01</size></box></geometry></collision>
        <collision name="deck_l3"><pose>0 0.10 1.175 0 0 0</pose>
          <geometry><box><size>1.20 0.35 0.01</size></box></geometry></collision>
        <!-- Bay dividers -->
        <collision name="div1"><pose>-0.30 0.10 0.90 0 0 0</pose>
          <geometry><box><size>0.01 0.35 1.80</size></box></geometry></collision>
        <collision name="div2"><pose>0.00 0.10 0.90 0 0 0</pose>
          <geometry><box><size>0.01 0.35 1.80</size></box></geometry></collision>
        <collision name="div3"><pose>0.30 0.10 0.90 0 0 0</pose>
          <geometry><box><size>0.01 0.35 1.80</size></box></geometry></collision>

        <!-- ── Visuals — each gets a UNIQUE name so Ogre2 doesn't hash-collide ── -->

        <visual name="vis_back_panel">
          <pose>0 0.185 0.90 0 0 0</pose>
          <geometry><box><size>1.20 0.03 1.80</size></box></geometry>
          <material><ambient>0.2 0.2 0.7 1</ambient><diffuse>0.15 0.15 0.65 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <visual name="vis_upright_left">
          <pose>-0.585 0.10 0.90 0 0 0</pose>
          <geometry><box><size>0.03 0.40 1.80</size></box></geometry>
          <material><ambient>0.2 0.2 0.7 1</ambient><diffuse>0.15 0.15 0.65 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <visual name="vis_upright_right">
          <pose>0.585 0.10 0.90 0 0 0</pose>
          <geometry><box><size>0.03 0.40 1.80</size></box></geometry>
          <material><ambient>0.2 0.2 0.7 1</ambient><diffuse>0.15 0.15 0.65 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <visual name="vis_beam_l0">
          <pose>0 0.00 0.25 0 0 0</pose>
          <geometry><box><size>1.20 0.04 0.04</size></box></geometry>
          <material><ambient>0.2 0.2 0.7 1</ambient><diffuse>0.15 0.15 0.65 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <visual name="vis_beam_l1">
          <pose>0 0.00 0.55 0 0 0</pose>
          <geometry><box><size>1.20 0.04 0.04</size></box></geometry>
          <material><ambient>0.2 0.2 0.7 1</ambient><diffuse>0.15 0.15 0.65 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <visual name="vis_beam_l2">
          <pose>0 0.00 0.85 0 0 0</pose>
          <geometry><box><size>1.20 0.04 0.04</size></box></geometry>
          <material><ambient>0.2 0.2 0.7 1</ambient><diffuse>0.15 0.15 0.65 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <visual name="vis_beam_l3">
          <pose>0 0.00 1.15 0 0 0</pose>
          <geometry><box><size>1.20 0.04 0.04</size></box></geometry>
          <material><ambient>0.2 0.2 0.7 1</ambient><diffuse>0.15 0.15 0.65 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <visual name="vis_deck_l0">
          <pose>0 0.10 0.275 0 0 0</pose>
          <geometry><box><size>1.20 0.35 0.01</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.70 0.70 0.70 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
        <visual name="vis_deck_l1">
          <pose>0 0.10 0.575 0 0 0</pose>
          <geometry><box><size>1.20 0.35 0.01</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.70 0.70 0.70 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
        <visual name="vis_deck_l2">
          <pose>0 0.10 0.875 0 0 0</pose>
          <geometry><box><size>1.20 0.35 0.01</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.70 0.70 0.70 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
        <visual name="vis_deck_l3">
          <pose>0 0.10 1.175 0 0 0</pose>
          <geometry><box><size>1.20 0.35 0.01</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.70 0.70 0.70 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
        <visual name="vis_div1">
          <pose>-0.30 0.10 0.90 0 0 0</pose>
          <geometry><box><size>0.01 0.35 1.80</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
        <visual name="vis_div2">
          <pose>0.00 0.10 0.90 0 0 0</pose>
          <geometry><box><size>0.01 0.35 1.80</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
        <visual name="vis_div3">
          <pose>0.30 0.10 0.90 0 0 0</pose>
          <geometry><box><size>0.01 0.35 1.80</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>

        <!-- Required inertial — static model but DART still needs it -->
        <inertial>
          <mass>50.0</mass>
          <inertia><ixx>10</ixx><iyy>10</iyy><izz>10</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
    </model>  <!-- end shelf_unit -->

    <!-- ══════════════════════════════════════════════════════════════════════
         P R O D U C T S — pump soap bottles
         Bottles: radius=0.035 m, length=0.200 m (cylinder)
         Level 1 deck top = z=0.575+0.005=0.580 m (world frame, shelf at y=0.20)
         Bottle centre z = 0.580 + 0.100 = 0.680 m
         Level 2 deck top = z=0.875+0.005=0.880, centre = 0.980 m
         Bay centres (world x): bay0=0.60+0.075=0.675, bay1=0.975, bay2=1.275, bay3=1.575
         NOTE: Bay 2 on level 1 is intentionally EMPTY (out-of-stock slot)
    ══════════════════════════════════════════════════════════════════════════ -->

    <!-- Level 1, Bay 0 — blue bottle -->
    <model name="bottle_l1_b0">
      <pose>0.675 0.10 0.680 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.5</mass>
          <inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.001</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.035</radius><length>0.200</length></cylinder></geometry>
          <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
        <visual name="vis_bottle_l1b0">
          <geometry><cylinder><radius>0.035</radius><length>0.200</length></cylinder></geometry>
          <material><ambient>0.3 0.6 0.9 1</ambient><diffuse>0.2 0.5 0.85 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Level 1, Bay 1 — amber bottle -->
    <model name="bottle_l1_b1">
      <pose>0.975 0.10 0.680 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.5</mass>
          <inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.001</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.035</radius><length>0.200</length></cylinder></geometry>
          <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
        <visual name="vis_bottle_l1b1">
          <geometry><cylinder><radius>0.035</radius><length>0.200</length></cylinder></geometry>
          <material><ambient>0.9 0.6 0.2 1</ambient><diffuse>0.85 0.55 0.15 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Level 1, Bay 2 — EMPTY (out-of-stock) -->

    <!-- Level 1, Bay 3 — purple bottle -->
    <model name="bottle_l1_b3">
      <pose>1.575 0.10 0.680 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.5</mass>
          <inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.001</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.035</radius><length>0.200</length></cylinder></geometry>
          <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
        <visual name="vis_bottle_l1b3">
          <geometry><cylinder><radius>0.035</radius><length>0.200</length></cylinder></geometry>
          <material><ambient>0.6 0.3 0.8 1</ambient><diffuse>0.55 0.25 0.75 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Level 2, Bay 0 — green bottle -->
    <model name="bottle_l2_b0">
      <pose>0.675 0.10 0.980 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.5</mass>
          <inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.001</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.035</radius><length>0.200</length></cylinder></geometry>
          <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
        <visual name="vis_bottle_l2b0">
          <geometry><cylinder><radius>0.035</radius><length>0.200</length></cylinder></geometry>
          <material><ambient>0.3 0.7 0.4 1</ambient><diffuse>0.25 0.65 0.35 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Level 2, Bay 2 — red bottle -->
    <model name="bottle_l2_b2">
      <pose>1.275 0.10 0.980 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.5</mass>
          <inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.001</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.035</radius><length>0.200</length></cylinder></geometry>
          <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
        <visual name="vis_bottle_l2b2">
          <geometry><cylinder><radius>0.035</radius><length>0.200</length></cylinder></geometry>
          <material><ambient>0.85 0.3 0.3 1</ambient><diffuse>0.80 0.25 0.25 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
